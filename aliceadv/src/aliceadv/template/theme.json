            "gap":      "1.2em",
            "maxWidth": "60%"
        },
        "toolbar": {
            "height": "6.5em",
            "gap":    "2em"
        }
    },

    "dialog": {
        "_comment": "对话框（文本框）外观。background=默认对话框图片；角色可用 characters.json 的 textbox 字段覆盖（缺省继承此处）。",
        "background": "gui/textbox.png"
    },

    "panel": {
        "_comment": "游戏内暂停菜单（点击舞台底部「菜单」弹出的浮层）配置。side=停靠方向(left/right/center)；width=窗口宽(px，相对 screen.designWidth 转比例)；height=窗口高(px，可选，相对 screen.designHeight，缺省为整屏高)；buttons=按钮顺序（键同 sidebar，另含 title=回到首页、back=返回/关闭浮层）。",
        "side": "right",
        "width": 500,
        "buttons": ["save", "load", "settings", "chapters", "gallery", "about", "title", "back"]
    },

    "notifyYpos": 68,
    "skipYpos": 15,

    "input": {
        "_comment": "按键 / 鼠标 / 滚轮 / 手柄的默认映射。写出的是**推荐方案**（presets），不是硬绑：玩家在设置页里可以逐动作改选某个方案或自己按键，改动只存在客户端 localStorage。绑定字符串语法：key:<键名>（键名取 KeyboardEvent.key 归一化，单字符小写，可加 ctrl/alt/shift/meta 前缀）、mouse:left|middle|right|x1|x2、wheel:up|down|left|right、pad:a|b|x|y|lb|rb|lt|rt|back|start|l3|r3|up|down|left|right（也可写数字下标 pad:0）。一个动作可以同时绑定多种设备（键盘 + 鼠标 + 手柄），也可以一个都不绑（可选功能）。default 决定玩家没有做过选择时跟随哪个方案。动作清单见 docs/输入与按键.md。手柄布局（两套方案一致）：A=推进/确认，B=隐藏UI（在菜单页里则是返回——B 同时绑了 Cancel 与 HideUI，靠优先级分层），X=菜单，Y=自动，LB=上一句，十字键四向=快捷轮盘四格的默认动作（上=自动、右=快存、下=快读、左=历史；十字键上下在有选项列表时先归列表导航）。",
        "default": "primary",
        "presets": [
            {
                "id": "primary",
                "label": "标准",
                "bindings": {
                    "Advance":       ["mouse:left", "key:enter", "key:space", "pad:a"],
                    "Confirm":       ["key:enter", "key:space", "pad:a"],
                    "Cancel":        ["key:escape", "pad:b"],
                    "Rollback":      ["key:pageup", "pad:lb"],
                    "ScrollBack":    ["wheel:up"],
                    "ScrollForward": ["wheel:down"],
                    "History":       ["mouse:middle", "pad:left"],
                    "Auto":          ["key:a", "pad:y", "pad:up"],
                    "SkipRead":      ["key:tab"],
                    "SkipAll":       ["key:shift+tab"],
                    "FastForward":   ["key:control"],
                    "HideUI":        ["key:h", "pad:b"],
                    "OpenMenu":      ["mouse:right", "pad:x", "key:escape"],
                    "QuickSave":     ["key:f5", "pad:right"],
                    "QuickLoad":     ["key:f9", "pad:down"],
                    "MenuUp":        ["key:arrowup", "pad:up"],
                    "MenuDown":      ["key:arrowdown", "pad:down"],
                    "NavUp":         ["pad:up"],
                    "NavDown":       ["pad:down"],
                    "NavLeft":       ["pad:left"],
                    "NavRight":      ["pad:right"]
                }
            },
            {
                "id": "nomouse",
                "label": "备用",
                "bindings": {
                    "Advance":       ["key:enter", "key:space", "pad:a"],
                    "Confirm":       ["key:enter", "key:space", "pad:a"],
                    "Cancel":        ["key:escape", "pad:b"],
                    "Rollback":      ["key:pageup", "pad:lb"],
                    "ScrollBack":    ["wheel:up"],
                    "ScrollForward": ["wheel:down"],
                    "History":       ["mouse:middle", "pad:left"],
                    "Auto":          ["key:a", "pad:y", "pad:up"],
                    "SkipRead":      ["key:tab"],
                    "SkipAll":       ["key:shift+tab"],
                    "FastForward":   ["key:control"],
                    "HideUI":        ["key:h", "pad:b"],
                    "OpenMenu":      ["mouse:right", "key:m", "pad:x", "key:escape"],
                    "QuickSave":     ["key:f5", "pad:right"],
                    "QuickLoad":     ["key:f9", "pad:down"],
                    "MenuUp":        ["key:arrowup", "pad:up"],
                    "MenuDown":      ["key:arrowdown", "pad:down"],
                    "NavUp":         ["pad:up"],
                    "NavDown":       ["pad:down"],
                    "NavLeft":       ["pad:left"],
                    "NavRight":      ["pad:right"]
                }
            }
        ]
    },

    "focus": {
        "_comment": "手柄方向键 / 左摇杆导航时，圈住当前候选按钮的「焦点框」外观。仅在识别到手柄时显示，作为默认样式（非调试态）。默认是白色实线环 + 一圈柔和白光，配合 focus.css 里写死的深色投影在任意背景上都读得清；所有项均可被工程 theme.json 覆盖（想要强调色环就把 frameColor / frameColorActive / glow 改成 colors.accent 同款）。",
        "frameWidth": "6px",
        "frameColor": "rgba(255, 255, 255, 0.95)",
        "frameColorActive": "rgba(255, 255, 255, 1)",
        "glow": "rgba(255, 255, 255, 0.5)",
        "radius": "12px",
        "transition": "130ms"
    },

    "gameMenu": {
        "_comment": "游戏内菜单页（sidebar 里的各页：保存/读取/设置/章节选择/剧情分支/画廊/关于）的共享外观默认值。backgroundColor = 整页半透明衬底（铺在背景图之上、内容之下，压淡底图）；panelColor = 主内容那一整块面板的底色（略微透明，让底图淡淡透出）；sidebarButtonColor = 侧栏每个按钮各自的底色（默认纯白、完全不透明，让按钮在任意背景图上都读得清）。三个键都支持 rgba()。此处即引擎默认值（构建时与工程 theme.json 深度合并，工程没写就用这里的；写 null 表示不要该层）。单个页面可在 pages.<页>.backgroundColor / panelColor / sidebarButtonColor 里覆盖。",
        "backgroundColor": "rgba(255, 255, 255, 0.4)",
        "panelColor": "rgba(255, 255, 255, 0.85)",
        "sidebarButtonColor": "#FFFFFF"
    },

