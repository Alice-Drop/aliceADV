    },

    "layout": {
        "dialogue": {
            "_comment": "height 为相对屏幕高(0~1)，构建翻译为百分比；.textbox 为 border-box，padding 计入 height。padTop/padBottom 可单独指定正文上下留白（缺省回落 padY），对应 Ren'Py dialogue_ypos；舞台是固定 1920x1080 设计画布，可直接写设计像素如 75px。",
            "left":   0.05,
            "bottom": 0.05,
            "width":  0.90,
            "height": 0.28,
            "padX":   "3.4em",
            "padY":   "2.4em",
            "padTop": "2.4em",
            "padBottom": "2.4em",
            "justify": "center",
            "textAlign": "left"
        },
        "name": {
            "_comment": "角色名框，相对文本框。anchor 是 Ren'Py gui.name_xalign 的等价物（0~1）：0=框左缘贴在 left 上、0.5=中点对齐、1=右缘对齐。",
            "left": 0.03,
            "top":  -0.07,
            "anchor": 0
        },
        "sprite": {
            "bottom": 0.00,
            "height": "auto"
        },
        "nvl": {
            "left": 0.1875,
            "width": 0.625,
            "lineGap": "0.5em",
            "justify": "center",
            "textAlign": "left"
        },
        "choice": {
            "left":     0.10,
            "top":      0.26,
            "width":    0.80,
            "gap":      "1.2em",
            "maxWidth": "60%"
        },
        "toolbar": {
            "height": "6.5em",
            "gap":    "2em"
        }
    },

    "dialog": {
        "_comment": "对话框（文本框）外观。background=默认对话框图片；角色可用 characters.json 的 textbox 字段覆盖（缺省继承此处）。",
        "background": "gui/textbox.png"
    },

    "panel": {
        "_comment": "游戏内暂停菜单（点击舞台底部「菜单」弹出的浮层）配置。side=停靠方向(left/right/center)；width=窗口宽(px，相对 screen.designWidth 转比例)；height=窗口高(px，可选，相对 screen.designHeight，缺省为整屏高)；buttons=按钮顺序（键同 sidebar，另含 title=回到首页、back=返回/关闭浮层）。",
        "side": "right",
        "width": 500,
        "buttons": ["save", "load", "settings", "chapters", "gallery", "about", "title", "back"]
    },

    "notifyYpos": 68,
    "skipYpos": 15,

    "gameMenu": {
        "_comment": "游戏内菜单页（sidebar 里的各页：保存/读取/设置/章节选择/剧情分支/画廊/关于）的共享外观默认值。backgroundColor = 整页半透明衬底（铺在背景图之上、内容之下，压淡底图）；panelColor = 主内容那一整块面板的底色（略微透明，让底图淡淡透出）；sidebarButtonColor = 侧栏每个按钮各自的底色（默认纯白、完全不透明，让按钮在任意背景图上都读得清）。三个键都支持 rgba()。此处即引擎默认值（构建时与工程 theme.json 深度合并，工程没写就用这里的；写 null 表示不要该层）。单个页面可在 pages.<页>.backgroundColor / panelColor / sidebarButtonColor 里覆盖。",
        "backgroundColor": "rgba(255, 255, 255, 0.4)",
        "panelColor": "rgba(255, 255, 255, 0.85)",
        "sidebarButtonColor": "#FFFFFF"
    },

    "sidebar": [
        "save", "load", "settings",
        "chapters", "gallery", "branches", "about", "back"
    ],

    "pages": {
        "title": {
            "layout": "left",
            "background": "gui/main_menu.png",
            "showName":   true,
            "showVersion":true,
            "buttons": [
                "start", "continue", "load", "settings", "chapters", "gallery", "branches", "about", "quit"
            ]
        },
        "save": {
            "background": "gui/game_menu.png",
            "title":      "保存",
            "titleEn":    "Save",
            "slotRows":   2,
            "slotCols":   3
        },
        "load": {
            "background": "gui/game_menu.png",
            "title":      "读取",
            "titleEn":    "Load",
            "slotRows":   2,
            "slotCols":   3
        },
        "settings": {
            "background": "gui/game_menu.png",
            "title":      "设置",
            "titleEn":    "Preferences"
        },
        "chapters": {
            "background": "gui/game_menu.png",
            "title":      "章节选择",
            "titleEn":    "Chapters"
        },
        "branches": {
            "background": "gui/game_menu.png",
            "title":      "剧情分支",
            "titleEn":    "Branches"
        },
        "stage": {
            "background": "images/bg/roof.png",
            "toolbar":    ["back", "history", "skip", "auto", "save", "qsave", "qload", "menu"]
        },
        "gallery": {
            "background": "gui/game_menu.png",
            "title":      "画廊",
            "titleEn":    "Gallery",
            "cols":       4
        },
        "about": {
            "background": "gui/main_menu.png",
            "_comment": "衬底的默认值都在顶层 gameMenu（所有菜单页共享），本页如需不同可在此覆盖 backgroundColor / panelColor / sidebarButtonColor，写 null 关闭该层。注意本页版式特殊：正文按固定栏宽排成一列，白底只包住这一列并水平居中（见 style/pages/about.css 的 .page_about 一节），panelColor 就是这张纸的底色，主内容区在本页不铺底色、纸的左右两侧直接透出 backgroundColor 那一层。想改「一行放多少字」调 about.css 的 --about-sheet-content。"
        }
    }
}
