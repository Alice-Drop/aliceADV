    "layout": {
        "dialogue": {
            "_comment": "height 为相对屏幕高(0~1)，构建翻译为百分比；.textbox 为 border-box，padding 计入 height。padTop/padBottom 可单独指定正文上下留白（缺省回落 padY），对应 Ren'Py dialogue_ypos；舞台是固定 1920x1080 设计画布，可直接写设计像素如 75px。",
            "left":   0.05,
            "bottom": 0.05,
            "width":  0.90,
            "height": 0.28,
            "padX":   "3.4em",
            "padY":   "2.4em",
            "padTop": "2.4em",
            "padBottom": "2.4em",
            "justify": "center",
            "textAlign": "left"
        },
        "name": {
            "_comment": "角色名框，相对文本框。anchor 是 Ren'Py gui.name_xalign 的等价物（0~1）：0=框左缘贴在 left 上、0.5=中点对齐、1=右缘对齐。",
            "left": 0.03,
            "top":  -0.07,
            "anchor": 0
        },
        "sprite": {
            "bottom": 0.00,
            "height": "auto"
        },
        "nvl": {
            "left": 0.1875,
            "width": 0.625,
            "lineGap": "0.5em",
            "justify": "center",
            "textAlign": "left"
        },
        "choice": {
            "left":     0.10,
